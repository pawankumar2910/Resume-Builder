{
  "name": "folio-resume-studio",
  "version": "1.0.0",
  "private": true,
  "description": "A private-by-design resume studio with local certificate parsing and PDF and Word exports.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node build.mjs",
    "dev": "node dev.mjs",
    "test": "node --test tests/*.test.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:build": "node scripts/check-build.mjs",
    "verify": "npm run format:check && npm test && npm run build && npm run check:build"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/noto-serif": "^5.3.0",
    "docx": "^9.5.1",
    "mammoth": "^1.10.0",
    "pdfjs-dist": "^6.5.438",
    "pdfmake": "0.3.14"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "prettier": "3.10.1"
  }
}
